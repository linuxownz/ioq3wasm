

        <form id="login" name="login" action="/" method="post">
            <input type="hidden" name="flag" value="1">
            <input type="hidden" name="rm"   value="login">
        </form>

        <div class="container">
            <header>[% appname %]</header>

            <section>
                <div class="signin">
                    <div class="content">
                        <h2>Sign In</h2>
                        <div class="form">
                            <div class="inputBox"> <input form="login" type="text"     name="username" id="username" autocomplete="on" required="required" maxlength="16"> <i>Username</i> </div>
                            <div class="inputBox"> <input form="login" type="password" name="password" id="password" autocomplete="on" required="required" maxlength="16" pattern="[0-9a-fA-F]{16}"> <i>Password</i> </div>
                            <div class="links"> <!--a href="#">Forgot Password</a--> <a href="https://discord.gg/Sd8z7QA8hf">Signup</a> </div>
                            <div class="inputBox">
                                <input form="login" type="submit" value="Login">
                            </div>
                            <div id="message">[% login_message | html %]</div>

                        </div>
                    </div>
                </div>
            </section>
        </div>

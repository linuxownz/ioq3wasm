                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">Machine Gun</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Machine Gun" name="weapon 2" class="form-input bind-input" value="[% binds.item('weapon 2').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">Shotgun</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Shotgun" name="weapon 3" class="form-input bind-input" value="[% binds.item('weapon 3').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">Grenade Launcher</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Grenade Launcher" name="weapon 4" class="form-input bind-input" value="[% binds.item('weapon 4').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">Rocket Launcher</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Rocket Launcher" name="weapon 5" class="form-input bind-input" value="[% binds.item('weapon 5').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">Lightning Gun</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Lightning Gun" name="weapon 6" class="form-input bind-input" value="[% binds.item('weapon 6').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">Rail Gun</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Rail Gun" name="weapon 7" class="form-input bind-input" value="[% binds.item('weapon 7').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">Plasma Gun</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Plasma Gun" name="weapon 8" class="form-input bind-input" value="[% binds.item('weapon 8').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                    </div>


                    <div class="scroll-page" id="basic_page">

                        <div class="row align-items-center">
                            <div class="col">
                                <h2>Basic</h2>
                            </div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col">
                            </div>
                        </div>

                        <!--div class="row row-bg align-items-center">
                            <div class="col">Player Model</div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Master Volume" name="" class="form-input cvar-input" value="[% binds.item('weapon 1').item('keys').join(' ').dquote | html %]"/>
                            </div>
                        </div-->

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                <label for="sensitivity">Master Volume</label>
                            </div>
                            <div class="col">
                                <div class="col d-flex align-items-center">
                                    <input type="range"  id="s_volume"  name="s_volume" min="0" max="1" step="0.1" value="[% config.s_volume | html %]" class="cvar-input"
                                                                                                                         oninput="document.getElementById('_s_volume').value=this.value" />
                                    <input type="number" id="_s_volume" name="s_volume" min="0" max="1" step="0.1" value="[% config.s_volume | html %]" class="cvar-input"
                                                                                                                         oninput="document.getElementById('s_volume').value=this.value" />
                                </div>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                <label for="sensitivity">Music Volume</label>
                            </div>
                            <div class="col">
                                <div class="col d-flex align-items-center">

    <form id="form" name="[% template_name %]" action="/" method="post">
        <input type="hidden" name="flag" value="1"/>
    </form>

    <script>
        var keys = JSON.parse("[% keys.dquote %]");
    </script>

    <dialog id="bindDialog">
        <div id="bindDialogContent">
            <div>Type a key to bind <span id="bindaction"></span></div>
            <div>
                <p><span id="bindkeys"/></p>
                <span><button id="bindDialogKeyboard">&#x2328;</button></span>
                <span><button id="bindDialogMouse" title="Hover over here and click mouse button, use mouse wheel">   &#x1f5b1;</button></span>
            </div>
            <div>Esc to exit, Backspace to unbind all </div>
            <div>Hover over mouse image and click or use mousewheel to set </div>
            <form method="dialog">
                <button id="bindDialogExit">Exit</button>
            </form>
        </div>

        <div id="keyboard">
            <!-- https://codepen.io/irajsuhail -->
            <div class="keyboard-base">
                <div data-key="~" class="key">~</div>
                <div data-key="1" class="key">1</div>
                <div data-key="2" class="key">2</div>
                <div data-key="3" class="key">3</div>
                <div data-key="4" class="key">4</div>
                <div data-key="5" class="key">5</div>
                <div data-key="6" class="key">6</div>
                <div data-key="7" class="key">7</div>
                <div data-key="8" class="key">8</div>
                <div data-key="9" class="key">9</div>
                <div data-key="0" class="key">0</div>
                <div data-key="-" class="key">-</div>
                <div data-key="+" class="key">+</div>
                <div data-key="DEL" class="key delete">Delete</div>
                <div data-key="TAB" class="key tab">Tab</div>
                <div data-key="Q" class="key">Q</div>
                <div data-key="W" class="key">W</div>
                <div data-key="E" class="key">E</div>
                <div data-key="R" class="key">R</div>
                <div data-key="T" class="key">T</div>
                <div data-key="Y" class="key">Y</div>
                <div data-key="U" class="key">U</div>
                <div data-key="I" class="key">I</div>
                <div data-key="O" class="key">O</div>
                <div data-key="P" class="key">P</div>
                <div data-key="[" class="key">[</div>
                <div data-key="]" class="key">]</div>
                <div data-key="\" class="key backslash">\</div>
                <div data-key="" class="key capslock">CapsLock</div>
                <div data-key="A" class="key">A</div>
                <div data-key="S" class="key">S</div>
                <div data-key="D" class="key">D</div>
                <div data-key="F" class="key">F</div>
                <div data-key="G" class="key">G</div>
                <div data-key="H" class="key">H</div>
                <div data-key="J" class="key">J</div>
                <div data-key="K" class="key">K</div>
                <div data-key="L" class="key">L</div>
                <div data-key=";" class="key">;</div>
                <div data-key="'" class="key">'</div>
                <div data-key="ENTER" class="key return">Return</div>
                <div data-key="SHIFT" class="key leftshift">Shift</div>
                <div data-key="Z" class="key">Z</div>
                <div data-key="X" class="key">X</div>
                <div data-key="C" class="key">C</div>
                <div data-key="V" class="key">V</div>
                <div data-key="B" class="key">B</div>
                <div data-key="N" class="key">N</div>
                <div data-key="M" class="key">M</div>
                <div data-key="," class="key">,</div>
                <div data-key="." class="key">.</div>
                <div data-key="/" class="key">/</div>
                <div data-key="SHIFT" class="key rightshift">Shift</div>
                <div data-key="CTRL" class="key leftctrl">Ctrl</div>
                <div data-key="META" class="key command"><img class="tux"src="/images/tux.png"></div>
                <div data-key="ALT" class="key">Alt</div>
                <div data-key="SPACE" class="key space">Space</div>
                <div data-key="ALT" class="key">Alt</div>
                <div data-key="META" class="key command"><img class="tux" src="/images/tux.png"></div>
                <div data-key="CTRL" class="key">Ctrl</div>
                <!--div data-key="" class="key"></div-->
            </div>
        </div>
    </dialog>

    <div class="container">
        <header>[% appname %]</header>
        [% INCLUDE nav.tt %]
        <section class="main_section">
            <div class="settings_main">

                <div id="nav" class="container-fluid">
                    <h1>Game Settings</h1>
                    <ul class="nav nav-pills">
                        <li class="nav-item">
                            <a class="nav-link" href="#input_page">Input</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#move_page">Movement</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#action_page">Action</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#weapon_page">Weapons</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#basic_page">Basic</a>
                        </li>
                        <!--li class="nav-item">
                            <a class="nav-link" href="#">Weapon</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Video</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Sound</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Spectating</a>
                        </li-->
                    </ul>
                </div>

                <div class="scroll-container">

                    <div class="scroll-page" id="input_page">
                        <div class="row align-items-center">
                            <div class="col">
                                <h2>Mouse Settings</h2>
                            </div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col">
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                <label for="sensitivity">Mouse Sensitivity</label>
                            </div>
                            <div class="col">
                                <div class="col d-flex align-items-center">
                                    <input type="range"  id="sensitivity"  name="sensitivity" min="0" max="10" step="0.1" value="[% config.sensitivity | html %]" class="cvar-input"
                                                                                                                         oninput="document.getElementById('_sensitivity').value=this.value" />
                                    <input type="number" id="_sensitivity" name="sensitivity" min="0" max="10" step="0.1" value="[% config.sensitivity | html %]" class="cvar-input"
                                                                                                                         oninput="document.getElementById('sensitivity').value=this.value" />
                                </div>
                            </div>
                        </div>


                        <div class="row row-bg align-items-center">
                            <div class="col">
                                <label for="cl_mouseAccel">Mouse Acceleration</label>
                            </div>
                            <div class="col">
                                <div class="col d-flex align-items-center">
                                    <input type="range"  id="cl_mouseAccel"  name="cl_mouseAccel" min="0" max="10" step="0.1" value="[% config.cl_mouseAccel | html %]" class="form-input cvar-input"
                                                                                                                         oninput="document.getElementById('_cl_mouseAccel').value=this.value" />
                                    <input type="number" id="_cl_mouseAccel" name="cl_mouseAccel" min="0" max="10" step="0.1" value="[% config.cl_mouseAccel | html %]" class="form-input cvar-input"
                                                                                                                         oninput="document.getElementById('cl_mouseAccel').value=this.value" />
                                </div>
                            </div>
                        </div>


                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                <label for="cl_mouseAccelOffset">Mouse Acceleration Offset</label>
                            </div>
                            <div class="col">
                                <div class="col d-flex align-items-center">
                                    <input type="range"  id="cl_mouseAccelOffset"  name="cl_mouseAccelOffset" min="0" max="10" step="0.1" value="[% config.cl_mouseAccelOffset | html %]" class="form-input cvar-input"
                                                                                                                         oninput="document.getElementById('_cl_mouseAccelOffset').value=this.value" />
                                    <input type="number" id="_cl_mouseAccelOffset" name="cl_mouseAccelOffset" min="0" max="10" step="0.1" value="[% config.cl_mouseAccelOffset | html %]" class="form-input cvar-input"
                                                                                                                         oninput="document.getElementById('cl_mouseAccelOffset').value=this.value" />
                                </div>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">Mouse Accel Style</div>
                            <div class="col">
                                <select title="Mouse Accel Style" name="cg_mouseAccelStyle" class="form-input cvar-input" >
                                    <option value="0" [%     config.item('cg_mouseAccelStyle') and "selected" %]>Style 1 ( default )</option>
                                    <option value="1" [% not config.item('cg_mouseAccelStyle') and "selected" %]>Style 2</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="scroll-page" id="move_page">

                        <div class="row align-items-center">
                            <div class="col">
                                <h2>Movement</h2>
                            </div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col">
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Move Forward
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Move Forward" name="+forward" class="form-input bind-input" value="[% binds.item('+forward').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Move Back
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Move Back" name="+back" class="form-input bind-input" value="[% binds.item('+back').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Move Left
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Move Left" name="+moveleft" class="form-input bind-input" value="[% binds.item('+moveleft').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Move Right
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Move Right" name="+moveright" class="form-input bind-input" value="[% binds.item('+moveright').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Jump
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Jump" name="+moveup" class="form-input bind-input" value="[% binds.item('+moveup').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Crouch
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Crouch" name="+movedown" class="form-input bind-input" value="[% binds.item('+movedown').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Walk
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Walk" name="+speed" class="form-input bind-input" value="[% binds.item('+speed').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                    </div>

                    <div class="scroll-page" id="action_page">

                        <div class="row align-items-center">
                            <div class="col">
                                <h2>Actions</h2>
                            </div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col">
                            </div>
                        </div>


                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Attack
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Attack" name="+attack" class="form-input bind-input" value="[% binds.item('+attack').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <!--div class="row row-bg align-items-center">
                            <div class="col">
                                Last Weapon
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Last Weapon" name="" class="form-input bind-input" value="[% # binds.item('').join(' ').dquote | html %]"/>
                            </div>
                        </div-->
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Next Weapon
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Next Weapon" name="weapnext" class="form-input bind-input" value="[% binds.item('weapnext').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Previous Weapon
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Previous Weapon" name="weapprev" class="form-input bind-input" value="[% binds.item('weapprev').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Zoom
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Zoom" name="+zoom" class="form-input bind-input" value="[% binds.item('+zoom').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Use Item
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Use Item" name="+button2" class="form-input bind-input" value="[% binds.item('+button2').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Taunt
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Taunt" name="+button3" class="form-input bind-input" value="[% binds.item('+button3').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Drop Flag Powerup Weapon
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Drop Flag Powerup Weapon" name="drop" class="form-input bind-input" value="[% binds.item('drop').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <!--div class="row row-bg align-items-center">
                            <div class="col">
                                Drop Weapon
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Drop Weapon" name="+dropX" class="form-input bind-input" value="[% binds.item('+dropX').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Drop Powerup
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Drop Powerup" name="+dropX" class="form-input bind-input" value="[% binds.item('+dropX').join(' ').dquote | html %]"/>
                            </div>
                        </div>
                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Drop Rune
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Drop Rune" name="+dropX" class="form-input bind-input" value="[% binds.item('+dropX').join(' ').dquote | html %]"/>
                            </div>
                        </div-->

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Self Kill
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Self Kill" name="kill" class="form-input bind-input" value="[% binds.item('kill').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Scoreboard
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Scoreboard" name="+scores" class="form-input bind-input" value="[% binds.item('+scores').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Vote Yes
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Vote Yes" name="vote yes" class="form-input bind-input" value="[% binds.item('vote yes').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Vote No
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Vote No" name="vote no" class="form-input bind-input" value="[% binds.item('vote no').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg-alt align-items-center">
                            <div class="col">
                                Ready up
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Ready up" name="ready" class="form-input bind-input" value="[% binds.item('ready').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Screenshot
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Screenshot" name="screenshot" class="form-input bind-input" value="[% binds.item('screenshot').join(' ').dquote | html %]"/>
                            </div>
                        </div>

                        <div class="row row-bg align-items-center">
                            <div class="col">
                                Talk
                            </div>
                            <div class="col">
                                <input type="text" readonly="readonly" title="Talk" name="messagemode" class="form-input bind-input" value="[% binds.item('messagemode').join(' ').dquote | html %]"/>

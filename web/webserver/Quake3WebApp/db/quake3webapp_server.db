--
-- Data for Name: server_console_commands; Type: TABLE DATA; Schema: webapp; Owner: campbell
--

COPY webapp.server_console_commands (command_name, command_description, arguments_mandatory, ignore, enabled, argument_accepted, argument_count) FROM stdin;
banaddr	Ban a user from being able to play on this server based on his ip address. Usage: banaddr (ip[/subnet] | clientnum [subnet])	t	f	t	t	1
say	say.  send chat command to all. say <message>	t	f	t	t	1
set	set.  Allows setting and defining of arbitrary cvars from console, even if they werent declared in C code. Usage set <cvar name> <value>	t	f	t	t	1
seta	seta.  Allows setting and defining of arbitrary cvars from console, even if they werent declared in C code and setting cvar CVAR_ACHIVE. Usage set <cvar name> <value>	t	f	t	t	1
writeconfig	writeconfig. Write the config file to a specific name.  usage: writeconfig <filename>	t	f	t	t	1
cmdlist	\N	f	f	t	t	0
cvarlist	cvarlist.  dumps list of defined cvars and their values	f	f	t	t	0
cvar_modified	cvar_modified.  dumps list of modifed cvars and their values	f	f	t	t	0
changeVectors	\N	f	f	t	f	0
devmap	\N	f	f	t	f	0
systeminfo	\N	f	f	t	f	0
banUser	\N	f	t	t	f	0
cvar_restart	cvar_restart.  Resets all cvars to their hardcoded values and removes userdefined variables and variables	f	f	t	f	0
spdevmap	\N	f	t	t	f	0
flushbans	flushbans. Delete all bans and exceptions	f	f	t	f	0
spmap	\N	f	t	t	f	0
kickall	kickall. kick all users off server. Usage: kickall	f	f	t	f	0
kickbots	kickbots. kick all bots off server. Usage: kickbots	f	f	t	f	0
killserver	killserver. shutdown the server	f	f	t	f	0
listbans	listbans. list all bans and exceptions	f	f	t	f	0
map_restart	map_restart. Completely restarts a level, but doesnt send a new gamestate to the clients.  This allows fair starts with variable load times. usage map_restart	f	f	t	f	0
net_restart	net_restart.  usage net_restart.  restarts networking if any cvars have changed.  see cvar_modified	f	f	t	f	0
path	path.  pak files on the path	f	f	t	f	0
quit	quit.  shutdown the server	f	f	t	f	0
status	status.  get status. dumps map name and players. Usage status	f	f	t	f	0
rehashbans	rehashbans.  reload bans from file	f	t	t	f	0
sectorlist	sectorlist.  lists sectors. usage sectorlist	f	f	t	f	0
serverinfo	serverinfo.  Dumps server info	f	f	t	f	0
touchFile	touchfile. touch a file.  usage  touchfile <filename> 	f	f	t	f	0
vstr	vstr. Inserts the current value of a variable as command text. usage unset <variable>  execute a variable command	f	f	t	f	0
hunklog	hunklog. dumps Hunk Log	f	f	f	f	0
echo	echo. echoes rest of arguments to console which is redirected to the log 	f	f	t	t	0
banClient	\N	t	t	t	t	1
game_restart	game_restart. Expose possibility to change current running mod to the user	f	t	f	f	0
heartbeat	heartbeat.  send heartbeat to master.  change the meaning of this TODO	f	t	t	f	0
hunksmalllog	hunksmalllog. dumps small Hunk Log	f	t	f	f	0
wait	wait. Causes execution of the remainder of the command buffer to be delayed until next frame.  This allows commands like: bind g "cmd use rocket ; +attack ; wait ; -attack ; cmd use blaster"	f	t	t	f	0
addbot	Usage: Addbot <botname> [skill 1-5] [team] [msec delay] [altname]	t	f	t	t	1
meminfo	meminfo. dump memory info report	f	f	t	t	0
zonelog	zonelog. zonelog report.  usage: zonelog.  The log is directed to the log ONLY.  no output	f	f	t	f	0
bandel	Remove a ban or an exception from the list. Usage: bandel (ip[/subnet] | num)	t	f	t	t	1
clientkick	Kick a user off of the server. Usage: clientkick <client number>	t	f	t	t	1
dir	dir.  lists contents of a directory.  usage: dir <directory> [extension]	t	f	t	t	1
dumpuser	dumpuser. Examine all a users info strings.  Usage: dumpuser <userid> 	t	f	t	t	1
exceptaddr	exceptaddr.  Ban a user from being able to play on this server based on his ip address but make an exception. Usage: exceptaddr (ip[/subnet] | clientnum [subnet])	t	f	t	t	1
exceptdel	exceptdel. Remove a ban or an exception from the list. Usage: exceptdel (ip[/subnet] | num)	t	f	t	t	1
exec	exec. exec <filename> : execute a script file	t	f	t	t	1
execq	execq. execq <filename> : execute a script file quietly	t	f	t	t	1
fdir	fdir. list directory contents with a filter.usage: fdir <filter>. example: fdir *q3dm*.bsp	t	f	t	t	1
kick	kick. kick user off server. Usage: kick <player name> kick all = kick everyone kick allbots = kick all bots	t	f	t	t	1
kicknum	kicknum. kick user off server by id. Usage: kicknum <clientnumber>	t	f	t	t	1
map	map. restart server on a different map. Usage map <mapname>	t	f	t	t	1
reset	reset.  reset cvar.  usage reset <cvarname>	t	f	t	t	1
sayto	sayto.  send chat to player. usage sayto <playername> <message>	t	f	t	t	1
setenv	setenv.  control environment variables. Usage setenv name value	t	f	t	t	1
sets	sets.  Allows setting and defining of arbitrary cvars from console, even if they werent declared in C code and setting cvar CVAR_SERVERINFO. Usage setu <cvar name> <value>	t	f	t	t	1
setu	setu.  Allows setting and defining of arbitrary cvars from console, even if they werent declared in C code and setting cvar CVAR_USERINFO. Usage setu <cvar name> <value>	t	f	t	t	1
tell	tell. tell something to someone. Usage tell <clientnum> <message> 	t	f	t	t	1
toggle	toggle. Toggles a cvar for easy single key binding, optionally through a list of given values.  usage  toggle <variable> [value1, value2, ...] 	t	f	t	t	1
unset	unset. unsets user defined cvar.  usage unset <varname>	t	f	t	t	1
which	which. which <file>	t	f	t	t	1
getcvar	Get the value of a cvar remotely	t	f	t	t	1
crash	crash the server for testing/debugging	f	f	t	f	0
\.



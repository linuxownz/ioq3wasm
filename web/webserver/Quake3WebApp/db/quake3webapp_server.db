--
-- Name: create_server_for_test(); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_server_for_test() RETURNS void
    LANGUAGE plpgsql
    AS $$

DECLARE

    new_instance_id uuid;
    spawn_request server_spawn_request%ROWTYPE;

BEGIN
    -- RUN: select * from reset_for_test(); select * from create_server_for_test();

    SELECT *
    INTO new_instance_id
    FROM create_server_spawn_request('q3ctf1');

    RAISE NOTICE 'created server with name q3ctf1';

    SELECT *
    INTO spawn_request
    FROM get_server_spawn_requests();

    RAISE NOTICE 'picked up server spawn request';
    RAISE NOTICE 'name: %',        spawn_request.server_name;
    RAISE NOTICE 'basegame % ',    spawn_request.basegame;
    RAISE NOTICE 'map_name % ',    spawn_request.map_name;
    RAISE NOTICE 'instance_id % ', spawn_request.instance_id;

    PERFORM update_server_spawn_request(new_instance_id, 77777, 'success'::server_spawn_request_result, 'test'::text);

END;

$$;


ALTER FUNCTION webapp.create_server_for_test() OWNER TO campbell;

--
-- Name: create_server_shutdown_request(uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_server_shutdown_request(_instance_id uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
BEGIN
    IF EXISTS(SELECT COUNT(*) FROM webapp.running_servers rs WHERE rs.instance_id = _instance_id AND state = 'running') THEN
        RAISE NOTICE 'sending quit to server ''%'' ', _instance_id;
        PERFORM webapp.create_request('quit', _instance_id, NULL );
        RETURN true;
    ELSE
        RAISE EXCEPTION 'server with instance id % does not exist in the running state', _instance_id;
    END IF;

    RETURN false;

END;
$$;


ALTER FUNCTION webapp.create_server_shutdown_request(_instance_id uuid) OWNER TO campbell;

--
-- Name: create_server_spawn_request(character varying, uuid, uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_server_spawn_request(server_name character varying, map uuid, owner uuid) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
    instance_id_new uuid;
    t1 text;
    t2 text;
    t3 text;
    newport integer;
BEGIN
    BEGIN

        -- map uuid is config_uuid
        -- map uuid is config_uuid
        -- map uuid is config_uuid

        SELECT MAX(port) + 1
        INTO newport
        FROM (
            SELECT port FROM running_servers WHERE state = 'running'
                UNION
            --SELECT port FROM server_spawn_request
            --    UNION
            SELECT 29759 AS port
        );

        INSERT INTO webapp.server_spawn_request ( server_name, config_uuid, port, owner )
        VALUES ( server_name, map, newport, owner )
        INTO instance_id_new
        RETURNING instance_id;

        NOTIFY proxy_notify_channel, 'server_spawn_request';

        RETURN instance_id_new;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'failed to insert server spawn request';
        WHEN OTHERS THEN
            GET STACKED DIAGNOSTICS t1 = MESSAGE_TEXT, t2 = PG_EXCEPTION_DETAIL, t3 = PG_EXCEPTION_HINT;
            RAISE EXCEPTION 'create_server_spawn_request: exception occured: % % %', t1, t2, t3;
    END;

    RETURN NULL;
END;
$$;


ALTER FUNCTION webapp.create_server_spawn_request(server_name character varying, map uuid, owner uuid) OWNER TO campbell;

--
-- Name: create_user(character varying, boolean, character varying, boolean, character varying, character varying); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_user(new_username character varying, new_enabled boolean, new_password character varying, new_admin boolean, new_fullname character varying, new_plaintext character varying) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
    username_unique integer;
    new_instance_id uuid;
    t1 text;
    t2 text;
    t3 text;
    newport integer;
BEGIN
    BEGIN

        SELECT count(*)
        INTO username_unique
        FROM webapp.users
        WHERE username = new_username;

        IF username_unique > 0 THEN
            RAISE EXCEPTION 'username % not unique', new_username;
            RETURN NULL;
        END IF;

        INSERT INTO webapp.users ( username, enabled, password, admin, fullname, plaintext )
        VALUES ( new_username, new_enabled, new_password, false, new_fullname, new_plaintext )
        INTO new_instance_id
        RETURNING id;

        -- create new default config

        INSERT INTO cvars(name, value, clientserver, owner)
        SELECT name, default_value, 'client', new_instance_id
        FROM cvar
        WHERE enabled = true AND
              clientserver = 'client' AND
              bind = false;


        INSERT INTO binds(name, value, owner)
        SELECT name, UPPER(default_value), new_instance_id
        FROM bind;

        -- INSERT INTO q3config ( name, value, bind, clientserver, owner, version )
        -- SELECT name, value, bind, clientserver, new_instance_id, 1
        -- FROM q3config
        -- WHERE
        --     clientserver = 'client' AND
        --     version      = 1        AND
        --     owner = (
        --         SELECT id
        --         FROM users
        --         WHERE username = 'system'
        -- );

        RETURN new_instance_id;
    EXCEPTION
        -- WHEN NO_DATA_FOUND THEN
        --    RAISE EXCEPTION 'failed to create user';
        WHEN OTHERS THEN
            GET STACKED DIAGNOSTICS t1 = MESSAGE_TEXT, t2 = PG_EXCEPTION_DETAIL, t3 = PG_EXCEPTION_HINT;
            RAISE EXCEPTION 'create_user: exception occured: % % %', t1, t2, t3;
    END;

    RETURN NULL;
END;
$$;


ALTER FUNCTION webapp.create_user(new_username character varying, new_enabled boolean, new_password character varying, new_admin boolean, new_fullname character varying, new_plaintext character varying) OWNER TO campbell;


--
-- Name: post_response(uuid, integer, text); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.post_response(instance_id uuid, request_id integer, response_text text) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
BEGIN
    INSERT INTO response ( instance_id, request_id, response )
    VALUES ( instance_id, request_id, response_text );

    UPDATE request
    SET request_state = 'complete'
    WHERE id = request_id;
END;
$$;


ALTER FUNCTION webapp.post_response(instance_id uuid, request_id integer, response_text text) OWNER TO campbell;

--
-- Name: proxy_login(integer); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.proxy_login(pid integer) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    cnt integer;
BEGIN
    -- LOCK TABLE proxy IN EXCLUSIVE MODE NOWAIT;

    BEGIN
        SELECT COUNT(*)
        INTO cnt
        FROM proxy;

        IF cnt > 0 THEN
            RAISE EXCEPTION 'ERROR: proxy_login: running proxy count > 0 %', cnt;
        END IF;

    END;

    INSERT INTO PROXY ( pid )
    VALUES ( pid );

    UPDATE server_spawn_request
    SET request_state = 'stale'::server_spawn_request_state
    WHERE request_state = 'new'::server_spawn_request_state;

    UPDATE proxy_request
    SET state = 'stale'::request_state
    WHERE state = 'new'::request_state;

END;
$$;


ALTER FUNCTION webapp.proxy_login(pid integer) OWNER TO campbell;

--
-- Name: proxy_logout(integer); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.proxy_logout(ppid integer) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
BEGIN
    BEGIN
        PERFORM
        FROM proxy
        WHERE pid = ppid;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'proxy with pid % not found in proxy table', ppid;
    END;

    DELETE FROM proxy WHERE pid = ppid;

END;
$$;


ALTER FUNCTION webapp.proxy_logout(ppid integer) OWNER TO campbell;

--
-- Name: remove_server_from_running_servers(uuid, integer); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.remove_server_from_running_servers(running_instance_id uuid, pid integer) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    server running_servers%ROWTYPE;
BEGIN

    BEGIN
        SELECT *
        INTO server
        FROM running_servers
        WHERE instance_id = running_instance_id;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'ERROR: Could not find running server with instance_id % to remove', running_instance_id;
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION 'ERROR: remove_server_from_running_servers instance_id % TOO MANY ROWS', running_instance_id;
    END;

    RAISE NOTICE 'server % % % has been shutdown', running_instance_id, pid, server.basegame;

    IF pid <> server.pid THEN
        RAISE NOTICE 'remove_server_from_running_servers pid % not match server.pid %', pid, server.pid;
    END IF;

    INSERT INTO running_server_log ( instance_id, server_name, basegame )
    VALUES ( server.instance_id, server.server_name, server.basegame );

    DELETE FROM running_servers
    WHERE instance_id = running_instance_id;

END;
$$;


ALTER FUNCTION webapp.remove_server_from_running_servers(running_instance_id uuid, pid integer) OWNER TO campbell;

--
-- Name: run_test_suite(); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.run_test_suite() RETURNS boolean
    LANGUAGE plpgsql
    AS $$
#print_strict_params on
DECLARE
    proxy_pid   integer;
    new_instance_id uuid;
    server running_servers%ROWTYPE;
    spawn_request server_spawn_request%ROWTYPE;
    spawn_request_count integer;
BEGIN

    IF count(*) <> 1 FROM proxy THEN
        RAISE EXCEPTION 'proxy does not appear to be running';
    END IF;

    SELECT pid INTO proxy_pid FROM proxy;
    RAISE NOTICE 'proxy.pl running pid %', proxy_pid;

    -- DELETE FROM proxy;
    DELETE FROM proxy_request;
    DELETE FROM request;
    DELETE FROM response;
    DELETE FROM server_spawn_request;
    DELETE FROM running_servers;

    -- create server spawn request
    SELECT * INTO /*STRICT*/ new_instance_id FROM 
    create_server_spawn_request('q3ctf1');

    SELECT COUNT(*) INTO spawn_request_count FROM server_spawn_request;
    RAISE NOTICE 'spawn_request_count %', spawn_request_count;

    IF spawn_request_count <> 1 FROM server_spawn_request THEN
        RAISE EXCEPTION 'failed to create server spawn request. %', spawn_request_count;
    END IF;

    RAISE NOTICE 'new running instance %', new_instance_id;

    -- find server spawn request in server_spawn_request table
    SELECT *
    INTO STRICT spawn_request
    FROM server_spawn_request
    WHERE instance_id = new_instance_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'failed to select * from server spawn request';
    END IF;

    RAISE NOTICE 'server spawn request % ', spawn_request; --.server_name;

    PERFORM pg_sleep(2);

    -- SELECT *
    -- INTO server
    -- FROM running_servers;

    -- IF NOT FOUND THEN
    --     RAISE EXCEPTION 'failed to spawn server';
    -- END IF;

    -- RAISE NOTICE 'new server % % ', server.instance_id, server.server_name;

    PERFORM create_request ( 'addbot', instance_id, 'anarki');

    RETURN TRUE;
END;
$$;


ALTER FUNCTION webapp.run_test_suite() OWNER TO campbell;

--
-- Name: update_player_bind(character varying, character varying, uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_player_bind(config_name character varying, config_value character varying, config_owner uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    cnt integer;
BEGIN
    -- select * from update_player_config('+forward', 'a', '83d2455f-af82-4df9-9998-d16bc4b0a857');  -- BIND

    IF config_name is NULL OR config_name = '' THEN
        RAISE EXCEPTION 'bad bind';
        RETURN false;
    END IF;

    IF config_value IS NULL or config_value = '' THEN
        -- config_value = '';
        -- RAISE NOTICE 'unsetting bind %', config_name;
    END IF;

    config_name  := LOWER(config_name);
    config_value := UPPER(config_value);

    IF config_value = 'BACKSPACE' THEN
        RAISE NOTICE 'deleting all binds with name = % ', config_name;
        DELETE FROM binds WHERE name = config_name and owner = config_owner;
        RETURN true;
    END IF;

    IF NOT EXISTS ( SELECT 1 FROM bind where LOWER(name) = config_name ) THEN
        RAISE EXCEPTION 'unknown bind %', config_name;
        RETURN false;
    END IF;

    IF EXISTS ( SELECT 1 FROM binds WHERE LOWER(name) = config_name and UPPER(value) = config_value and owner = config_owner ) THEN
        RAISE NOTICE 'bind already set to "%" "%"', config_name, config_value;

        -- DELETE FROM binds WHERE LOWER(name) = config_name and UPPER(value) = config_value and owner = config_owner;

        -- GET DIAGNOSTICS cnt = row_count;
        -- IF cnt != 1 THEN
        --     RAISE EXCEPTION 'failed to delete % % %', config_name, config_value, cnt;
        -- END IF;

        RETURN true;
    END IF;

    -- +attack is bound to MOUSE1
    -- +attack is ALSO bound to CTRL

    -- you want to bind CTRL to +movedown

    -- remove +attack, CTRL bind

    DELETE FROM binds WHERE UPPER(value) = config_value and LOWER(name) != config_name and owner = config_owner;
    GET DIAGNOSTICS cnt = row_count; IF cnt = 1 THEN RAISE NOTICE 'deleting bind name != %  value = %', config_name, config_value; END IF;

    -- add +movedown, CTRL

    RAISE NOTICE 'inserting bind name % = value %', config_name, config_value;
    INSERT INTO binds ( name, value, owner )
    VALUES ( config_name, config_value, config_owner );

    RETURN true;
END;

$$;


ALTER FUNCTION webapp.update_player_bind(config_name character varying, config_value character varying, config_owner uuid) OWNER TO campbell;

--
-- Name: update_player_cvar(character varying, character varying, uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_player_cvar(config_name character varying, config_value character varying, config_owner uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    cnt integer;
BEGIN
    -- select * from update_player_config('+forward',      'a',  true, '83d2455f-af82-4df9-9998-d16bc4b0a857');  -- BIND
    -- select * from update_player_config('s_volume', '0.6875', false, '83d2455f-af82-4df9-9998-d16bc4b0a857' ); -- CVAR

    IF config_name is NULL OR config_name = '' THEN
        RAISE EXCEPTION 'bad config_name';
        RETURN false;
    END IF;

    IF config_value IS NULL OR config_value = '' THEN
        config_value := '';
        RAISE NOTICE 'unsetting cvar %', config_name ;
    END IF;

    IF ( SELECT COUNT(*) FROM cvar WHERE LOWER(name) = LOWER(config_name) ) = 0 THEN
        RAISE EXCEPTION 'cvar % does not exist', config_name;
    END IF;

    IF EXISTS ( SELECT 1 FROM cvars where LOWER(name) = LOWER(config_name) and value = config_value and owner = config_owner ) THEN
        RAISE NOTICE 'cvar % already has value %',config_name, config_value ;
        RETURN false;
    END IF;

    UPDATE cvars SET value = config_value WHERE LOWER(name) = LOWER(config_name) and owner = config_owner;

    GET DIAGNOSTICS cnt = row_count;

    IF cnt = 0 THEN
        RAISE WARNING 'failed to update cvar % with value % count: %', config_name, config_value, cnt;

        INSERT into cvars(name, value, clientserver, owner) VALUES(config_name, config_value, 'client', config_owner);

        GET DIAGNOSTICS cnt = row_count;

        IF cnt != 1 THEN
            RAISE EXCEPTION 'failed to insert cvar % with value % count: %', config_name, config_value, cnt;
            RETURN FALSE;
        END IF;
    END IF;

    RETURN true;
END;

$$;


ALTER FUNCTION webapp.update_player_cvar(config_name character varying, config_value character varying, config_owner uuid) OWNER TO campbell;

--
-- Name: update_proxy_request(integer, text); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_proxy_request(request_id integer, request_response text) RETURNS void
    LANGUAGE plpgsql
    AS $$

DECLARE
    request proxy_request%ROWTYPE;
BEGIN

    BEGIN
        SELECT *
        INTO request
        FROM proxy_request
        WHERE request.id = request_id;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'proxy_request % not found', request_id;
    END;

    IF request.state <> 'executing' THEN
        RAISE EXCEPTION 'proxy_request state != executing %', request.state;
    END IF;

    UPDATE proxy_request pr
    SET
        state    = 'complete',
        response = request_response
    WHERE
        pr.id = request_id;

END;
$$;


ALTER FUNCTION webapp.update_proxy_request(request_id integer, request_response text) OWNER TO campbell;


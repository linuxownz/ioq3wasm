--
-- Name: RESET_FOR_TEST(); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp."RESET_FOR_TEST"() RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN

    RAISE NOTICE 'deleting from proxy';
    RAISE NOTICE 'deleting from q3serverlog';
    RAISE NOTICE 'deleting from request';
    RAISE NOTICE 'deleting from response';
    RAISE NOTICE 'deleting from running_servers';
    RAISE NOTICE 'deleting from server_spawn_request';
    RAISE NOTICE 'deleting from sessions';

    DELETE from proxy;
    DELETE FROM q3serverlog;
    DELETE FROM request ;
    DELETE from response;
    DELETE FROM running_servers;
    DELETE FROM server_spawn_request ;
    DELETE FROM sessions;

END;
$$;


ALTER FUNCTION webapp."RESET_FOR_TEST"() OWNER TO campbell;

--
-- Name: create_proxy_request(character varying); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_proxy_request(request_text character varying) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
    new_request_id integer;
BEGIN

    IF request_text IS NULL OR request_text = '' THEN
        RAISE EXCEPTION 'request_text cannot be NULL';
    END IF;

    INSERT INTO proxy_request ( request )
    VALUES ( request_text )
    RETURNING id
    INTO new_request_id;

    NOTIFY proxy_notify_channel, 'proxy_request';

    RETURN new_request_id;
END;
$$;


ALTER FUNCTION webapp.create_proxy_request(request_text character varying) OWNER TO campbell;

--
-- Name: create_request(character varying, uuid, text); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.create_request(command_text character varying, target_instance_id uuid, arguments text) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
    new_request_id integer;
    command server_console_commands%ROWTYPE;
    owner uuid;
    arg1 text;
    arg2 text;
BEGIN
    IF target_instance_id IS NULL THEN
        RAISE EXCEPTION 'target_instance_id cannot be NULL';
    END IF;

    IF command_text IS NULL OR command_text = '' THEN
        RAISE EXCEPTION 'command_text cannot be NULL';
    END IF;

    IF NOT EXISTS ( SELECT 1 FROM running_servers WHERE instance_id = target_instance_id AND state = 'running'::server_state ) THEN
        RAISE EXCEPTION 'no server found or not in running state for instance_id %', target_instance_id;
    END IF;

    BEGIN
        SELECT *
        INTO STRICT command
        FROM server_console_commands
        WHERE command_name = command_text;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RAISE EXCEPTION 'command % not found', command_text;
    END;

    IF command.ignore = true THEN
        RAISE EXCEPTION 'command % is set to ignore', command_text;
    END IF;

    IF command.enabled = false THEN
        RAISE EXCEPTION 'command % is set to enabled false', command_text;
    END IF;

    IF command_text = 'set' or command_text = 'seta' or command_text = 'sets' or command_text = 'setu' THEN
        -- get owner from server_spawn_request

        SELECT ssr.owner INTO owner FROM server_spawn_request ssr WHERE ssr.instance_id = target_instance_id;
        RAISE NOTICE 'set command update server config TODO % % : % "%"', target_instance_id, owner, command_text, arguments;

        SELECT split_part(arguments, ' ', 1) INTO arg1;
        SELECT split_part(arguments, ' ', 2) INTO arg2;

        RAISE NOTICE '% "%"', arg1, arg2;

        -- update_server_config(config_name character varying, config_value character varying, config_owner uuid)
        PERFORM update_server_config ( arg1, arg2, owner );
    END IF;

    INSERT INTO request ( command, request_state, arguments, target_server )
    VALUES ( command_text, 'new'::request_state, arguments, target_instance_id )
    RETURNING id
    INTO new_request_id;

    NOTIFY proxy_notify_channel, 'server_request';

    RETURN new_request_id;
END;
$$;


ALTER FUNCTION webapp.create_request(command_text character varying, target_instance_id uuid, arguments text) OWNER TO campbell;


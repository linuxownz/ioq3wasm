            WHEN (bind = true) THEN 'bind'::text
            ELSE 'seta'::text
        END || ' '::text) || (name)::text) || ' "'::text) || (value)::text) || '"'::text) AS line
   FROM webapp.q3config
  WHERE (clientserver = 'server'::webapp.clientserver)

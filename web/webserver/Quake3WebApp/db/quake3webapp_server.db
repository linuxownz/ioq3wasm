 SELECT res.request_id,
    (res."timestamp" - req."timestamp") AS duration,
    req."timestamp" AS req_timestamp,
    res."timestamp" AS res_timestamp,
    res.response
   FROM (webapp.request req
     JOIN webapp.response res ON ((req.id = res.request_id)));



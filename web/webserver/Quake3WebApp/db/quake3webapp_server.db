--
-- Name: func_text(character varying); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.func_text(func_name character varying) RETURNS TABLE(function character varying, full_text character varying)
    LANGUAGE plpgsql
    AS $$
BEGIN
   RETURN QUERY
    SELECT P.proname :: varchar, F.full_text :: varchar
    FROM
    (
      SELECT oid, proname
      FROM pg_proc
      WHERE lower(proname) like '%' || lower(func_name) || '%'
    ) AS P
    JOIN LATERAL
    (SELECT pg_get_functiondef(P.oid) AS full_text) AS F ON TRUE;
END
$$;


ALTER FUNCTION webapp.func_text(func_name character varying) OWNER TO campbell;

--
-- Name: get_player_config(uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.get_player_config(config_owner uuid) RETURNS TABLE(config_name character varying, config_value character varying, config_bind boolean)
    LANGUAGE plpgsql
    AS $$
DECLARE

BEGIN
    -- TODO get config by uuid (DONE) AND MAP

    RETURN QUERY

    SELECT name, value, bind
    FROM (

        SELECT name, string_agg ( value, ' ' )::character varying as value, true as bind
        FROM  binds
        WHERE owner = config_owner
        group by name, owner

        UNION

        SELECT name, value, false as bind
        FROM cvars
        WHERE owner = config_owner and clientserver = 'client'
        ORDER by bind, name, value
    );

END;
$$;


ALTER FUNCTION webapp.get_player_config(config_owner uuid) OWNER TO campbell;


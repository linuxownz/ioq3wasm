--
-- Name: update_server_config(character varying, character varying, uuid); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_server_config(config_name character varying, config_value character varying, config_owner uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    cnt integer;
BEGIN
    -- select * from update_player_config('+forward',      'a',  true, '83d2455f-af82-4df9-9998-d16bc4b0a857');  -- BIND
    -- select * from update_player_config('s_volume', '0.6875', false, '83d2455f-af82-4df9-9998-d16bc4b0a857' ); -- CVAR

    IF config_name is NULL OR config_name = '' THEN
        RAISE EXCEPTION 'bad config_name';
        RETURN false;
    END IF;

    IF config_value IS NULL OR config_value = '' THEN
        config_value := '';
        RAISE NOTICE 'unsetting cvar %', config_name ;
    END IF;

    IF ( SELECT COUNT(*) FROM cvar WHERE name = config_name ) = 0 THEN
        RAISE EXCEPTION 'cvar % does not exist', config_name;
    END IF;

    IF EXISTS ( SELECT 1 FROM cvars where name = config_name and value = config_value and owner = config_owner ) THEN
        RAISE NOTICE 'cvar % already has value %',config_name, config_value ;
        RETURN false;
    END IF;

    UPDATE cvars SET value = config_value WHERE name = config_name and owner = config_owner and clientserver = 'server';

    GET DIAGNOSTICS cnt = row_count;

    IF cnt = 1 THEN
        RAISE NOTICE 'UPDATED % % server', config_name, config_value;
        RETURN true;
    ELSE
        RAISE NOTICE 'failed to UPDATE % % server, attempting INSERT', config_name, config_value;

        INSERT INTO cvars ( name, value, clientserver, owner ) VALUES ( config_name, config_value, 'server', config_owner );

        GET DIAGNOSTICS cnt = row_count;

        IF cnt = 1 THEN
            return true;
        END IF;

        RAISE EXCEPTION 'failed to insert cvar % with value %', config_name, config_value;

        RETURN FALSE;
    END IF;

END;

$$;


ALTER FUNCTION webapp.update_server_config(config_name character varying, config_value character varying, config_owner uuid) OWNER TO campbell;

--
-- Name: update_server_info(uuid, integer, text, text, webapp.server_state); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_server_info(_instance_id uuid, _port integer, _mapname text, _json text, _state webapp.server_state) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
BEGIN

    UPDATE
    running_servers
    SET
        port        = _port,
        json        = _json,
        state       = _state,
        mapname     = _mapname
    WHERE
        instance_id = _instance_id;
END;
$$;


ALTER FUNCTION webapp.update_server_info(_instance_id uuid, _port integer, _mapname text, _json text, _state webapp.server_state) OWNER TO campbell;

--
-- Name: update_server_spawn_request(uuid, integer, webapp.server_spawn_request_result, text); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_server_spawn_request(update_instance_id uuid, pid integer, result webapp.server_spawn_request_result, spawn_reply text) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    spawn_request server_spawn_request%ROWTYPE;
BEGIN

    -- RAISE NOTICE 'starting server_spawn_request % request_state=%, request_result=%, result_text=%', (SELECT now()), 'complete', result, spawn_reply;

    BEGIN

        SELECT *
        INTO spawn_request -- one row and one row only
        FROM server_spawn_request
        WHERE instance_id = update_instance_id;

    EXCEPTION

        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'server spawn request % not found', update_instance_id;
        WHEN TOO_MANY_ROWS THEN
            -- should never happen
            RAISE EXCEPTION 'server spawn request % returned more than one row?', update_instance_id;

    END;

    IF spawn_request.request_state <> 'pending' THEN
        RAISE EXCEPTION 'server spawn request % not in pending state', update_instance_id;
    END IF;

    IF spawn_request.request_result <> 'unknown' THEN
        RAISE EXCEPTION 'server spawn request % result not in state unknown', update_instance_id;
    END IF;

    -- RAISE NOTICE 'updating server_spawn_request request_state=%, request_result=%, result_text=%', 'complete', result, spawn_reply;

    UPDATE server_spawn_request s
    SET
        request_state  = 'complete',
        request_result = result,
        result_text    = spawn_reply
    WHERE instance_id  = update_instance_id;

    IF result = 'success' THEN
        INSERT INTO
            running_servers ( instance_id, server_name, pid, basegame, port, config_uuid )
        VALUES (
            update_instance_id, spawn_request.server_name, pid, spawn_request.basegame, spawn_request.port, spawn_request.config_uuid
        );
    ELSE
        RAISE EXCEPTION 'result not success % ', result;
    END IF;
END;
$$;


ALTER FUNCTION webapp.update_server_spawn_request(update_instance_id uuid, pid integer, result webapp.server_spawn_request_result, spawn_reply text) OWNER TO campbell;

--
-- Name: update_server_state(uuid, webapp.server_state, text); Type: FUNCTION; Schema: webapp; Owner: campbell
--

CREATE FUNCTION webapp.update_server_state(inst_id uuid, new_state webapp.server_state, _reason text) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE

BEGIN

    RAISE NOTICE 'update_server_state % % %', inst_id, new_state, _reason;

    BEGIN
        UPDATE running_servers
        SET
            state  = new_state,
            reason = _reason
        WHERE instance_id = inst_id;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION 'update_server_state instance_id % not found', inst_id;
    END;

END;
$$;


ALTER FUNCTION webapp.update_server_state(inst_id uuid, new_state webapp.server_state, _reason text) OWNER TO campbell;


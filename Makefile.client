SDLSRCFILES = \
 	$(CODE_DIR)/sdl/sdl_input.c \
 	$(CODE_DIR)/sdl/sdl_glimp.c \
 	$(CODE_DIR)/sdl/sdl_snd.c

CONSRCFILES = \
 	$(CODE_DIR)/sys/con_console.c \
 	$(CODE_DIR)/sys/con_log.c

SYSSRCFILES = \
 	$(CODE_DIR)/sys/sys_main_client.c \
 	$(CODE_DIR)/sys/sys_unix_client.c

WEBPAGESRCFILES = \
 	$(CODE_DIR)/web/quake3.html

# PREJSSRCFILE = \
# 	$(CODE_DIR)/web/pre.js

CGAMEOBJS        := $(CGAMESRCFILES:%=$(BUILD_DIR)/%.o)
CLIENTOBJS       := $(CLIENTSRCFILES:%=$(BUILD_DIR)/%.o)
GAMEOBJS         := $(GAMESRCFILES:%=$(BUILD_DIR)/%.o)
QCOMMONOBJS      := $(QCOMMONSRCFILES:%=$(BUILD_DIR)/%.o)
RENDERCOMMONOBJS := $(RENDERCOMMONSRCFILES:%=$(BUILD_DIR)/%.o)
RENDERGL2OBJS    := $(RENDERGL2SRCFILES:%=$(BUILD_DIR)/%.o)
SDLOBJS          := $(SDLSRCFILES:%=$(BUILD_DIR)/%.o)
CONOBJS          := $(CONSRCFILES:%=$(BUILD_DIR)/%.o)
SYSOBJS          := $(SYSSRCFILES:%=$(BUILD_DIR)/%.o)

ALLOBJS := $(CGAMEOBJS) $(CLIENTOBJS) $(GAMEOBJS) $(QCOMMONOBJS) $(RENDERCOMMONOBJS) $(RENDERGL2OBJS) $(CONOBJS) $(SYSOBJS)

ALLSRCFILES := $(CGAMESRCFILES) $(CLIENTSRCFILES) $(GAMESRCFILES) $(QCOMMONSRCFILES) $(RENDERCOMMONSRCFILES) $(RENDERGL2SRCFILES) $(CONSRCFILES) $(SYSSRCFILES)

ALLOBJS += $(SDLOBJS)
ALLSRCFILES += $(SDLSRCFILES)

TARGET = quake3.js
TARGET = quake3.wasm
TARGET = quake3.html

# PREJS = --pre-js=$(PREJSSRCFILE)

# strip MY NAME from builds
# strip MY NAME from builds

.PHONY: all clean

all: pre-build build

pre-build:
	$(shell ./bin/make_shader.sh)
	$(shell ./bin/make_tags.sh)
	$(shell ./bin/make_cscope.sh)
	@touch ./code/sys/sys_main_client.c

build: $(BUILD_DIR)/$(TARGET)

$(BUILD_DIR)/$(TARGET): $(ALLOBJS)
	$(CC) $(ALLOBJS) -o $@ $(LINKER_FLAGS)
	@echo

$(BUILD_DIR)/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) -c $(COMPILE_FLAGS) $< -o $@
	@echo

clean:
	@rm -rf ./$(BUILD_DIR)
	@echo

docs:
	doxygen ioquake3_doc.doxygen

listsourcefiles:
	@echo $(ALLSRCFILES)

showcompileflags:
	@echo $(COMPILE_FLAGS)

showlinkerflags:
	@echo $(LINKER_FLAGS)


#
# ioq3 Makefile client wasm
#

# we want to statically link to have one wasm binary
# there will be no qvm, the vm will be removed
# this means that all mods MUST live in game/cgame

SHELL=/bin/bash

DEBUG      ?= 0
PROFILING  ?= 0
STANDALONE ?= 0
USE_OGG    ?= 0

ifndef VERSION
VERSION=1.36
# TODO
# VERSION=2.00
endif

ifndef BASEGAME
BASEGAME=baseq3
endif

ifndef MISSIONPACK
# TODO
#MISSIONPACK=missionpack
endif

ifndef CODE_DIR
CODE_DIR=code
endif

ifndef WED_DIR
WEB_DIR=web
endif

ifndef BUILD_DIR
BUILD_DIR=build/client/
endif

# Add git version info
ifeq ($(wildcard .git),.git)
 #GIT_REV=$(shell git show -s --pretty=format:%h-%ad --date=short)
  GIT_REV=$(shell git show -s --pretty=format:%h)
endif

#############################################################################
# SETUP AND BUILD -- LINUX EMSCRIPTEN
#############################################################################
# COMPILER FLAGS ############################################################

# fails to compile when asking for debug info
# emcc: error: running limited binaryen optimizations because DWARF info requested (or indirectly required) [-Wlimited-postlink-optimizations] [-Werror]
# COMPILE_FLAGS = -Wall -Werror
# TODO
COMPILE_FLAGS  = -Wall
COMPILE_FLAGS += -DCLIENT

ifeq ($(USE_OGG),1)
  COMPILE_FLAGS += -DUSE_OGG
endif

# https://emscripten.org/docs/porting/multimedia_and_graphics/OpenGL-support.html
# https://registry.khronos.org/OpenGL-Refpages/es2.0/
# COMPILE_FLAGS += -FULL_ES2 -FULL_ES3
# COMPILE_FLAGS += -FULL_ES2

# https://lyceum-allotments.github.io/2016/06/emscripten-and-sdl2-tutorial-part-4-look-owl/
#COMPILE_FLAGS += -USE_SDL=2 -USE_SDL_IMAGE=2 -SDL2_IMAGE_FORMATS='["png"]'
COMPILE_FLAGS += -sUSE_SDL=2
COMPILE_FLAGS += -sUSE_SDL_MIXER=2
#COMPILE_FLAGS += -sUSE_LIBJPEG=1
COMPILE_FLAGS += -sUSE_LIBPNG

ifeq ($(DEBUG), 1)
  COMPILE_FLAGS += -DDEBUG
endif

# emcc --show-ports

# https://reproducible-builds.org/specs/source-date-epoch/
ifdef SOURCE_DATE_EPOCH
	COMPILE_FLAGS += -DPRODUCT_DATE=\\\"$(shell date --date="@$$SOURCE_DATE_EPOCH" "+%b %_d %Y" | sed -e 's/ /\\\ /'g)\\\"
endif

COMPILE_FLAGS += -DVERSION="\"$(VERSION)\""
COMPILE_FLAGS += -DGIT_REV="\"$(GIT_REV)\""

COMPILE_FLAGS += -Wformat=2 -Wno-format-zero-length -Wformat-security -Wno-format-nonliteral
COMPILE_FLAGS += -Wstrict-aliasing=2 -Wmissing-format-attribute
COMPILE_FLAGS += -Wdisabled-optimization
COMPILE_FLAGS += -Werror-implicit-function-declaration
#COMPILE_FLAGS += -ferror-limit=10

# ALIGNMENT ISSUES TONS OF ISSUES....
COMPILE_FLAGS += -Wcast-align -Wover-aligned

ifeq ($(USE_OGG), 1)
COMPILE_FLAGS += -sUSE_OGG=1
COMPILE_FLAGS += -sUSE_VORBIS
COMPILE_FLAGS += -DUSE_CODEC_VORBIS
endif

COMPILE_FLAGS += -DUSE_OPENAL

ifeq ($(DEBUG), 1)
  COMPILE_FLAGS += -DOPENAL_DEBUG
endif

# DEBUGGING
# -----------------------------
# COMPILE_FLAGS += -g2
# COMPILE_FLAGS += -g
# COMPILE_FLAGS += -gsource-map
#

# https://github.com/emscripten-core/emscripten/issues/11425
ifeq ($(DEBUG), 1)
  COMPILE_FLAGS += -g
# COMPILE_FLAGS += -gsource-map
# COMPILE_FLAGS += -s DISABLE_EXCEPTION_CATCHING=0
else
  COMPILE_FLAGS += -O3
endif

ifeq ($(PROFILING),1 1)
  COMPILE_FLAGS += --profiling
endif

# LINKER FLAGS ######################################################################################################

ifeq ($(DEBUG), 1)
  LINKER_FLAGS += --source-map-base /
  LINKER_FLAGS += -s ASSERTIONS=1
  LINKER_FLAGS += -gsource-map
  LINKER_FLAGS += -Os  # to help isolcate only the func I use
else
  LINKER_FLAGS += -O3
endif

ifeq ($(PROFILING), 1)
  LINKER_FLAGS += --profiling
endif

#LINKER_FLAGS += -sTOTAL_MEMORY=256MB
LINKER_FLAGS += -sTOTAL_MEMORY=192MB
#LINKER_FLAGS += -sTOTAL_MEMORY=512MB

# LINKER_FLAGS += -sSTACK_SIZE=131072
# working but maybe stack is too big TODO  trying to change large static buffers when I find them
# LINKER_FLAGS += -sSTACK_SIZE=1048576
#LINKER_FLAGS += -sSTACK_SIZE=262144 # this one blows up
#LINKER_FLAGS += -sSTACK_SIZE=524288
#LINKER_FLAGS += -sSTACK_SIZE=327680 # blows up

LINKER_FLAGS += -sSTACK_SIZE=393216 # ok

LINKER_FLAGS += -sALLOW_MEMORY_GROWTH=1


#build just the js and wasm files see:
# https://github.com/emscripten-core/emscripten/wiki/WebAssembly-Standalone
# https://v8.dev/blog/emscripten-standalone-wasm
ifeq ($(STANDALONE), 1)
LINKER_FLAGS += -sSTANDALONE_WASM
endif

# LINKER_FLAGS += "-sEXPORTED_RUNTIME_METHODS['callMain']"

# https://emscripten.org/docs/api_reference/fetch.html
LINKER_FLAGS += -sFETCH

# disable SAFE_HEAP if -fsanitize=address is enabled
# disabled Dec28 maybe because if alignment fault could be a soft error
# 15:35:19.272 RuntimeError: Aborted(alignment fault) quake3.js:574:40
# https://github.com/emscripten-core/emscripten/blob/db9b1fbed657c6f1261ff635015abc36482b157a/src/settings.js#L322

ifeq ($(DEBUG), 1)
#LINKER_FLAGS += -sSAFE_HEAP=1
  LINKER_FLAGS += -sSAFE_HEAP=2
  LINKER_FLAGS += -sWARN_UNALIGNED=1

  LINKER_FLAGS += -sSTACK_OVERFLOW_CHECK=1
  LINKER_FLAGS += -sSTACK_OVERFLOW_CHECK=2
  LINKER_FLAGS += -sASSERTIONS=1
endif

# LINKER_FLAGS += --emrun

LINKER_FLAGS += -sUSE_LIBJPEG=1
LINKER_FLAGS += -sUSE_SDL_MIXER=2

LINKER_FLAGS += -lopenal
LINKER_FLAGS += -lSDL2
LINKER_FLAGS += -lwebsocket.js
# to get browser support of image decoding just added not tested
LINKER_FLAGS += -lbrowser.js

# https://github.com/emscripten-core/emscripten/issues/4425 ????
LINKER_FLAGS += -sUSE_WEBGL2=1
LINKER_FLAGS += -sMIN_WEBGL_VERSION=2
LINKER_FLAGS += -sMAX_WEBGL_VERSION=2
#LINKER_FLAGS += -sGL_ENABLE_GET_PROC_ADDRESS

LINKER_FLAGS += -lGL
LINKER_FLAGS += -sFULL_ES2=1
LINKER_FLAGS += -sFULL_ES3=1

LINKER_FLAGS += -sEXIT_RUNTIME=1

# LINKER_FLAGS += -sGL_ASSERTIONS=1
# LINKER_FLAGS += -sTRACE_WEBGL_CALLS=1
# LINKER_FLAGS += -sGL_DEBUG=1
# LINKER_FLAGS += -sGL_TESTING=1
# LINKER_FLAGS += -sGL_TRACK_ERRORS=1

# LINKER_FLAGS += -fsanitize=undefined # too many locals
# LINKER_FLAGS += -fsanitize=address

CC=emcc


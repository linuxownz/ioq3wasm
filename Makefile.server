#
# ioq3 SERVER ONLY Makefile
# non wasm but including websockets
#
# meson?

SHELL=/bin/bash

STRIP=0

COVERAGE=0

ifndef VERSION
VERSION=1.36
endif

ifndef CODE_DIR
CODE_DIR=code
endif

ifndef BUILD_DIR
BUILD_DIR=build/server/
endif

#############################################################################

PKG_CONFIG = pkg-config

# Add git version info
ifeq ($(wildcard .git),.git)
  GIT_REV=$(shell git show -s --pretty=format:%h-%ad --date=short)
  GIT_BRANCH=$(shell git branch --show-current)
  ifneq ($(GIT_REV),)
    VERSION:=$(VERSION)_GIT_$(GIT_BRANCH)_$(GIT_REV)
  endif
endif

#############################################################################
# SETUP AND BUILD -- LINUX
#############################################################################
COMPILE_FLAGS  = -Wall -Werror -Wextra -fno-strict-aliasing -Wimplicit -Wstrict-prototypes -Wunused -Wunused-function
#COMPILE_FLAGS += -DARCH_STRING=\"Linux\"
COMPILE_FLAGS += -DBOTLIB
COMPILE_FLAGS += -DSERVER=1
COMPILE_FLAGS += -O3 -ffast-math
COMPILE_FLAGS += -IwsServer/include

DEBUG_FLAGS  = -Wall -Werror -ggdb
#DEBUG_FLAGS += -DARCH_STRING=\"Linux\"
DEBUG_FLAGS += -DBOTLIB
DEBUG_FLAGS += -DDEBUG 
DEBUG_FLAGS += -DSERVER=1

#zlib-static.x86_64
COMPILE_FLAGS += $(shell $(PKG_CONFIG) --silence-errors --cflags zlib || true)
DEBUG_FLAGS   += $(shell $(PKG_CONFIG) --silence-errors --cflags zlib || true)

# for gcov
# You have to pass -fprofile-arcs -ftest-coverage when compiling.
# You have to pass -fprofile-arcs when linking.
# https://stackoverflow.com/questions/566472/where-are-the-gcov-symbols

ifneq ($(COVERAGE),0)
  DEBUG_FLAGS += --coverage -fprofile-arcs -ftest-coverage
endif

# CC=emcc run under node?
CC=gcc

ifeq ($(STRIP),1)
  COMPILE_FLAGS += -s
endif

# # https://reproducible-builds.org/specs/source-date-epoch/
# ifdef SOURCE_DATE_EPOCH
#   COMPILE_FLAGS += -DPRODUCT_DATE=\\\"$(shell date --date="@$$SOURCE_DATE_EPOCH" "+%b %_d %Y" | sed -e 's/ /\\\ /'g)\\\"
# endif

# COMPILE_FLAGS += -DPRODUCT_VERSION=\"$(VERSION)\"
COMPILE_FLAGS += -Wformat=2 -Wno-format-zero-length -Wformat-security -Wno-format-nonliteral
COMPILE_FLAGS += -Wstrict-aliasing=2 -Wmissing-format-attribute
COMPILE_FLAGS += -Wdisabled-optimization
COMPILE_FLAGS += -Werror-implicit-function-declaration

# LINKER FLAGS
LINKER_FLAGS += $(shell $(PKG_CONFIG) --silence-errors --libs zlib   || echo -lz)
LINKER_FLAGS += -lm -lssl -lcrypto

# git submodule wsServer
LINKER_FLAGS += -L ./code/wsServer
LINKER_FLAGS += -lws

DEBUGLINKER_FLAGS = $(LINKER_FLAGS)
ifneq ($(COVERAGE),0)
  DEBUGLINKER_FLAGS += -fprofile-arcs
endif

#############################################################################
# DEDICATED SERVER
#############################################################################


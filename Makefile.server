	$(CODE_DIR)/game/ai_dmnet.c \
	$(CODE_DIR)/game/ai_dmq3.c \
	$(CODE_DIR)/game/ai_main.c \
	$(CODE_DIR)/game/ai_team.c \
	$(CODE_DIR)/game/ai_vcmd.c \
	$(CODE_DIR)/game/bg_misc.c \
	$(CODE_DIR)/game/bg_pmove.c \
	$(CODE_DIR)/game/bg_slidemove.c \
	$(CODE_DIR)/game/g_active.c \
	$(CODE_DIR)/game/g_arenas.c \
	$(CODE_DIR)/game/g_bot.c \
	$(CODE_DIR)/game/g_client.c \
	$(CODE_DIR)/game/g_cmds.c \
	$(CODE_DIR)/game/g_combat.c \
	$(CODE_DIR)/game/g_items.c \
	$(CODE_DIR)/game/g_main.c \
	$(CODE_DIR)/game/g_mem.c \

Q3DEDSYSOBJS      := $(Q3DEDSYSFILES:%=$(BUILD_DIR)/%.o)
Q3DEDBOTLIBOBJS   := $(Q3DEDBOTLIBFILES:%=$(BUILD_DIR)/%.o)
Q3DEDSERVEROBJS   := $(Q3DEDSERVERFILES:%=$(BUILD_DIR)/%.o)
Q3DEDQCOMMONOBJS  := $(Q3DEDQCOMMONFILES:%=$(BUILD_DIR)/%.o)
Q3DEDBASEGAMEOBJS := $(Q3DEDBASEGAMEFILES:%=$(BUILD_DIR)/%.o)

ALLOBJS := $(Q3DEDSYSOBJS) $(Q3DEDBOTLIBOBJS) $(Q3DEDSERVEROBJS) $(Q3DEDQCOMMONOBJS) $(Q3DEDBASEGAMEOBJS)

DEBQ3DEDSYSOBJS      := $(Q3DEDSYSFILES:%=$(BUILD_DIR)/%.d.o)
DEBQ3DEDBOTLIBOBJS   := $(Q3DEDBOTLIBFILES:%=$(BUILD_DIR)/%.d.o)
DEBQ3DEDSERVEROBJS   := $(Q3DEDSERVERFILES:%=$(BUILD_DIR)/%.d.o)
DEBQ3DEDQCOMMONOBJS  := $(Q3DEDQCOMMONFILES:%=$(BUILD_DIR)/%.d.o)
DEBQ3DEDBASEGAMEOBJS := $(Q3DEDBASEGAMEFILES:%=$(BUILD_DIR)/%.d.o)

DEBOBJS := $(DEBQ3DEDSYSOBJS) $(DEBQ3DEDBOTLIBOBJS) $(DEBQ3DEDSERVEROBJS) $(DEBQ3DEDQCOMMONOBJS) $(DEBQ3DEDBASEGAMEOBJS)

ALLSRCFILES := $(Q3DEDSYSFILES) $(Q3DEDBOTLIBFILES) $(Q3DEDSERVERFILES) $(Q3DEDQCOMMONFILES) $(Q3DEDBASEGAMEFILES)

# ws for websockets
RELTARGET = ioq3dedws.x86_64
DEBTARGET = ioq3dedws_debug.x86_64

# strip MY NAME from builds
# strip MY NAME from builds
#
#  >>>>> CURRENTLY converting to be all statically compiled, no vm <<<<<
#  CHECK THAT THE SERVER STILL WORKS BEFORE CONVERTING/ADDING WEBSOCKET SUPPORT
#

.PHONY: all clean release debug

all: pre-build build

pre-build:
	@echo pre-build

build: $(BUILD_DIR)/$(RELTARGET)

release: $(BUILD_DIR)/$(RELTARGET)

debug: $(BUILD_DIR)/$(DEBTARGET)

# release build
$(BUILD_DIR)/$(RELTARGET): $(ALLOBJS)
	$(CC) $(ALLOBJS) -o $@ $(LINKER_FLAGS)
	@echo
	@echo built release $@

$(BUILD_DIR)/$(DEBTARGET): $(DEBOBJS)
	$(CC) $(DEBOBJS) -o $@ $(DEBUGLINKER_FLAGS)
	@echo
	@echo built debug $@

$(BUILD_DIR)/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) -c $(COMPILE_FLAGS) $< -o $@
	@echo

$(BUILD_DIR)/%.c.d.o: %.c
	@mkdir -p $(dir $@)
	$(CC) -c $(DEBUG_FLAGS) $< -o $@
	@echo

clean:
	@rm -rf ./$(BUILD_DIR)
	@echo

docs:
	doxygen ioquake3_doc.doxygen

listsourcefiles:
	@echo $(ALLSRCFILES)

# program has to be run after building
coverage:
	@lcov --capture --directory $(BUILD_DIR) --output-file coverage.info
	@genhtml coverage.info --output-directory server_docs/coverage


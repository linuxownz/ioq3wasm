	$(CODE_DIR)/game/g_missile.c \
	$(CODE_DIR)/game/g_mover.c \
	$(CODE_DIR)/game/g_session.c \
	$(CODE_DIR)/game/g_spawn.c \
	$(CODE_DIR)/game/g_svcmds.c \
	$(CODE_DIR)/game/g_target.c \
	$(CODE_DIR)/game/g_team.c \
